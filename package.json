{
  "name": "vira-enterprise-genui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json",
    "build:experience-studio": "pnpm --filter @vira-enterprise-genui/experience-studio-demo build",
    "build:production-web": "pnpm --filter @vira-enterprise-genui/vira-web build",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:production-shell": "vitest run tests/production/production-shell.test.ts",
    "test:production-db": "vitest run tests/production/postgres-transaction.test.ts",
    "test:identity-delegation": "vitest run tests/production/identity-delegation.test.ts tests/production/oidc-discovery.test.ts",
    "test:browser-security": "vitest run tests/production/browser-security.test.ts tests/production/bff-security.test.ts tests/production/postgres-identity-session.test.ts tests/production/bff-ingress.test.ts tests/production/vercel-bff.test.ts",
    "check:boundaries": "node tooling/check-package-boundaries.mjs",
    "generate:studio-interop": "node tooling/generate-studio-interop.mjs && node tooling/finalize-studio-interop.mjs",
    "check:studio-interop": "node tooling/check-studio-interop.mjs",
    "check:studio-native": "node tooling/check-studio-native-conformance.mjs",
    "genui": "node packages/genui-cli/bin/vira-genui.mjs",
    "verify": "pnpm verify:plan-coherence && pnpm verify:production-shell && pnpm verify:production-db:static && pnpm verify:identity-delegation:static && pnpm verify:studio-authoring && pnpm verify:studio-flow && pnpm verify:studio-simulation && pnpm verify:application-v2 && pnpm verify:application-v1-v2-migration && pnpm verify:application-v2-consumers && pnpm verify:application-deployment && pnpm verify:application-resolution && pnpm check:studio-interop && pnpm check:boundaries && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:experience-studio",
    "verify:browser": "pnpm --filter @vira-enterprise-genui/experience-studio-demo test:e2e",
    "verify:all": "pnpm verify && pnpm verify:browser",
    "verify:plan-coherence": "node tooling/verify-plan-coherence.mjs",
    "verify:production-shell": "npm ci --prefix .railway --ignore-scripts && npm --prefix .railway run validate && node tooling/verify-production-shell.mjs && pnpm test:production-shell && pnpm build:production-web",
    "verify:production-db:static": "node tooling/verify-production-db.mjs && pnpm test:production-db",
    "verify:production-db": "pnpm verify:production-db:static && node tooling/verify-production-db-live.mjs && node tooling/verify-application-deployment-db-live.mjs",
    "verify:tenant-isolation": "node tooling/verify-production-db-live.mjs && node tooling/verify-application-deployment-db-live.mjs",
    "verify:identity-delegation:static": "node tooling/verify-identity-delegation.mjs && pnpm test:identity-delegation && pnpm test:browser-security",
    "verify:identity-delegation": "pnpm verify:identity-delegation:static && node tooling/verify-identity-delegation-live.mjs",
    "verify:browser-security": "pnpm test:browser-security",
    "verify:studio-authoring": "vitest run packages/studio-lifecycle/tests",
    "verify:studio-flow": "vitest run tests/contract/application-canvas-v2-mutation.test.ts tests/contract/application-canvas-collaboration-v2.test.ts",
    "verify:studio-simulation": "vitest run tests/contract/application-canvas-simulation-v2.test.ts",
    "verify:application-v2": "vitest run tests/contract/application-v2.test.ts",
    "verify:application-v1-v2-migration": "vitest run tests/contract/application-v1-v2-migration.test.ts",
    "verify:application-v2-consumers": "vitest run tests/contract/application-v2-consumers.test.ts",
    "verify:application-deployment": "vitest run tests/contract/application-deployment-v2.test.ts tests/contract/application-deployment-postgres-store.test.ts",
    "verify:application-resolution": "vitest run tests/contract/application-resolution.test.ts",
    "verify:ios-simulator": "node tooling/run-ios-simulator-gate.mjs",
    "verify:android-emulator": "node tooling/run-android-emulator-gate.mjs",
    "verify:external-brand-proof": "node tooling/verify-external-brand-proof-evidence.mjs",
    "verify:external-publisher-proof": "vitest run examples/external-publisher-proof/external-publisher-proof.test.ts tests/contract/application-federation-release-owner.test.ts",
    "verify:external-ai-host-proof": "vitest run examples/external-ai-host-proof/external-ai-host-proof.test.ts tests/contract/application-ai-host-exact-reference-owner.test.ts",
    "verify:external-provider-proof": "vitest run examples/external-provider-proof/external-provider-proof.test.ts tests/contract/capability-exact-reference-owner.test.ts",
    "verify:application-network-cross-surface": "vitest run examples/application-network-rc/application-network-rc.test.ts examples/application-network-rc/application-network-rc-hardening.test.ts tests/contract/capability-release-reference-owner.test.ts",
    "verify:application-network-rc": "node tooling/verify-application-network-rc.mjs",
    "verify:enterprise-rc": "node tooling/verify-enterprise-rc.mjs",
    "demo:experience-studio": "pnpm --filter @vira-enterprise-genui/experience-studio-demo dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@vira-enterprise-genui/studio-runtime": "workspace:*",
    "eslint": "10.9.1",
    "react": "19.2.8",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
