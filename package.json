{
  "name": "vira-enterprise-genui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json",
    "build:experience-studio": "pnpm --filter @vira-enterprise-genui/experience-studio-demo build",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "check:boundaries": "node tooling/check-package-boundaries.mjs",
    "verify": "pnpm check:boundaries && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:experience-studio",
    "demo:flight-search": "pnpm build && pnpm --filter @vira-enterprise-genui/flight-search-demo start",
    "demo:experience-studio": "pnpm --filter @vira-enterprise-genui/experience-studio-demo dev",
    "demo:pegasus-chat": "pnpm --filter @vira-enterprise-genui/pegasus-chat-demo dev",
    "demo:pegasus-chat:check": "pnpm --filter @vira-enterprise-genui/pegasus-chat-demo typecheck && pnpm --filter @vira-enterprise-genui/pegasus-chat-demo build"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/gateway": "4.0.62",
      "@ai-sdk/mcp": "2.0.36",
      "@ai-sdk/openai": "4.0.46",
      "@ai-sdk/provider-utils": "5.0.29",
      "@ai-sdk/react": "4.0.80",
      "ai": "7.0.77"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
