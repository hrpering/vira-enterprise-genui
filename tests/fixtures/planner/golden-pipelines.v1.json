{
  "version": "1",
  "cases": [
    {
      "name": "travel-missing-date-resolves-first",
      "input": {
        "id": "travel-plan-1",
        "intent": { "version": "1", "namespace": "travel.flight", "name": "search" },
        "state": { "origin": "IST", "destination": "BER" },
        "requiredState": ["origin", "destination", "departure-date"],
        "capabilityRequirements": [
          { "field": "departure-date", "capability": { "version": "1", "id": "select-date" } }
        ],
        "availableCapabilities": [
          { "version": "1", "id": "edit-passengers" }
        ],
        "futureCapabilities": [
          { "version": "1", "id": "display.flight-results" }
        ]
      },
      "expectedPlan": {
        "version": "1",
        "id": "travel-plan-1",
        "intent": { "version": "1", "namespace": "travel.flight", "name": "search" },
        "state": { "origin": "IST", "destination": "BER" },
        "capabilities": {
          "required": [{ "version": "1", "id": "select-date" }],
          "available": [{ "version": "1", "id": "edit-passengers" }],
          "future": [{ "version": "1", "id": "display.flight-results" }]
        }
      },
      "expectedComposition": {
        "planId": "travel-plan-1",
        "mode": "resolve",
        "primary": [{ "version": "1", "id": "select-date" }],
        "supporting": [{ "version": "1", "id": "edit-passengers" }],
        "deferred": [{ "version": "1", "id": "display.flight-results" }]
      }
    },
